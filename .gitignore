# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.agents/

# Data (large / generated)
data/erp_attention/
data/benchmarks/
*.npy
*.npz
*.pt
*.pkl
*.onnx

# ...except the small corpora that reproduce the real-attention runs
!data/erp_attention/
!data/erp_attention/corpus.txt
!data/erp_attention/corpus_scaled.txt
data/erp_attention/corpus_large.txt

# Logs and run artifacts
logs/
logs_smoke/
*.log
wandb/

# ...except tracked results (freeze reproducible state)
!logs/
!logs/**/
!logs/**/*.json
# ...but not the raw stdout/stderr captures (noise, not results)
logs/**/*.out
logs/**/*.err

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large cloned agent repos (if present at workspace root)
agents/

# Secrets
.env
*.key
*.pem

# Model cache (attention exports are large)
models/
cache/